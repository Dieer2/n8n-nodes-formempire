{
  "name": "n8n-nodes-formempire",
  "version": "0.1.0",
  "description": "n8n nodes for FormEmpire: new form submissions as a trigger, plus reading and updating submissions.",
  "license": "MIT",
  "homepage": "https://formempire.hu",
  "keywords": [
    "n8n-community-node-package",
    "formempire",
    "forms",
    "webhook"
  ],
  "author": {
    "name": "FormEmpire",
    "email": "hello@formempire.hu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dieer2/n8n-nodes-formempire.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/FormEmpireApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FormEmpire/FormEmpire.node.js",
      "dist/nodes/FormEmpireTrigger/FormEmpireTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.0",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
