{
  "compilerOptions": {
    "strict": true, "module": "commonjs", "moduleResolution": "node", "target": "es2019", "lib": ["es2020", "es2022.error"],
    "removeComments": true, "useUnknownInCatchVariables": false, "forceConsistentCasingInFileNames": true, "noImplicitAny": true,
    "noImplicitReturns": true, "noUnusedLocals": true, "strictNullChecks": true, "preserveConstEnums": true, "esModuleInterop": true,
    "declaration": true, "sourceMap": true, "skipLibCheck": true, "outDir": "./dist/", "types": ["node"], "resolveJsonModule": true
  },
  "include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json"]
}
